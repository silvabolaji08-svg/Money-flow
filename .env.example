# ---------------------------------------------------------------------------
# MoneyFlow environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (app runtime + migrations).
# Local docker:  postgresql://moneyflow:moneyflow@localhost:5432/moneyflow?schema=public
# Local Prisma dev server (`npx prisma dev --name moneyflow`) prints one for you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moneyflow?schema=public"

# Optional. Only needed when your database user cannot create shadow databases
# (most managed Postgres providers). Used by `prisma migrate dev` only.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------

# Secret used to sign/encrypt session JWTs. REQUIRED in every environment.
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Vercel sets this automatically.
AUTH_URL="http://localhost:3000"

# Set to "true" when running behind a proxy/container that rewrites the host
# header (Docker, Railway, Fly, most self-hosted setups).
AUTH_TRUST_HOST="true"
